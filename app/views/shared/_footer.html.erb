<footer class="modern-footer">
  <div class="footer-container">

    <!-- =========================
         FOOTER MAIN
    ========================== -->
    <div class="footer-main">

      <!-- Brand -->
      <div class="footer-brand">

        <%= link_to root_path, class: "footer-logo" do %>
          X<span>iamen.</span>
        <% end %>

        <p class="footer-description">
          Xiamen: Leading oil derivatives exporter delivering premium products
          worldwide with unmatched service, forging lasting partnerships.
        </p>

        <div class="footer-socials">
          <a href="#" aria-label="LinkedIn">
            <i class="fa-brands fa-linkedin-in"></i>
          </a>

          <a href="#" aria-label="Instagram">
            <i class="fa-brands fa-instagram"></i>
          </a>

          <a href="#" aria-label="Facebook">
            <i class="fa-brands fa-facebook-f"></i>
          </a>

          <a href="#" aria-label="WhatsApp">
            <i class="fa-brands fa-whatsapp"></i>
          </a>
        </div>

      </div>


      <!-- Offices -->
      <div class="footer-offices">

        <div class="footer-heading">
          Our Offices
        </div>

        <div class="office-list">

          <div class="office">
            <div class="office-icon">
              <i class="fa-solid fa-location-dot"></i>
            </div>

            <div class="office-content">
              <strong>Tehran</strong>
              <p>No. 24, Valiasr Street, Tehran, Iran</p>
            </div>
          </div>


          <div class="office">
            <div class="office-icon">
              <i class="fa-solid fa-location-dot"></i>
            </div>

            <div class="office-content">
              <strong>Bandar Abbas</strong>
              <p>No. 18, Imam Khomeini Boulevard, Bandar Abbas, Iran</p>
            </div>
          </div>


          <div class="office">
            <div class="office-icon">
              <i class="fa-solid fa-location-dot"></i>
            </div>

            <div class="office-content">
              <strong>Hong Kong</strong>
              <p>Unit 1208, 12/F, Exchange Tower, Hong Kong</p>
            </div>
          </div>


          <div class="office">
            <div class="office-icon">
              <i class="fa-solid fa-location-dot"></i>
            </div>

            <div class="office-content">
              <strong>Dubai</strong>
              <p>Level 41, Emirates Towers, Sheikh Zayed Road, Dubai, UAE</p>
            </div>
          </div>

        </div>
      </div>


      <!-- Explore -->
      <div class="footer-links-column">

        <div class="footer-heading">
          Explore
        </div>

        <%= link_to products_path do %>
          <span>Products</span>
          <i class="fa-solid fa-arrow-up-right-from-square"></i>
        <% end %>

        <%= link_to posts_path do %>
          <span>Articles</span>
          <i class="fa-solid fa-arrow-up-right-from-square"></i>
        <% end %>

        <%= link_to about_path do %>
          <span>About Us</span>
          <i class="fa-solid fa-arrow-up-right-from-square"></i>
        <% end %>

        <%= link_to contact_path do %>
          <span>Contact Us</span>
          <i class="fa-solid fa-arrow-up-right-from-square"></i>
        <% end %>

      </div>


      <!-- Contact -->
      <div class="footer-contact">

        <div class="footer-heading">
          Get in touch
        </div>


        <!-- Email -->
        <%= mail_to "info@xiamen-co.com", class: "footer-contact-link" do %>
          <i class="fa-regular fa-envelope"></i>
          <span>info@xiamen-co.com</span>
        <% end %>


        <!-- Phone -->
        <%= link_to "tel:+971505128033", class: "footer-contact-link" do %>
          <i class="fa-solid fa-phone"></i>
          <span>+971 505 12 8033</span>
        <% end %>


        <p class="footer-contact-description">
          Questions about products, pricing or supply?
        </p>


        <!-- CTA -->
        <%= link_to inquiry_path, class: "footer-inquiry" do %>
          <span>Make an inquiry</span>

          <i class="fa-solid fa-arrow-right"></i>
        <% end %>

      </div>

    </div>


    <!-- =========================
         FOOTER BOTTOM
    ========================== -->

    <div class="footer-bottom">

      <span>
        © 2026 Xiamen. All rights reserved.
      </span>

      <div class="footer-legal">

        <%= link_to "Privacy Policy", "#" %>

        <%= link_to "Terms", "#" %>

      </div>

    </div>

  </div>
</footer>