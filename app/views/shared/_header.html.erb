</header>

<script>
  (function () {

    function initHeader() {

      /* =====================================================
         SEARCH
      ===================================================== */

      const searchToggle =
        document.getElementById("search-toggle");

      const searchDropdown =
        document.getElementById("search-dropdown");

      const searchInput =
        document.getElementById("search-input");


      if (
        searchToggle &&
        searchDropdown &&
        searchToggle.dataset.searchInitialized !== "true"
      ) {

        searchToggle.dataset.searchInitialized = "true";

        searchToggle.addEventListener("click", function (event) {

          event.preventDefault();
          event.stopPropagation();

          searchDropdown.classList.toggle("active");

          if (
            searchDropdown.classList.contains("active") &&
            searchInput
          ) {

            setTimeout(function () {
              searchInput.focus();
            }, 50);

          }

        });


        searchDropdown.addEventListener("click", function (event) {
          event.stopPropagation();
        });

      }


      /* =====================================================
         MOBILE MAIN MENU
      ===================================================== */

      const siteHeader =
        document.getElementById("site-header");

      const mobileToggle =
        document.querySelector(".mobile-menu-toggle");

      const mobileNavigation =
        document.getElementById("mobile-navigation");


      if (
        siteHeader &&
        mobileToggle &&
        mobileNavigation &&
        mobileToggle.dataset.mobileInitialized !== "true"
      ) {

        mobileToggle.dataset.mobileInitialized = "true";


        mobileToggle.addEventListener("click", function (event) {

          event.preventDefault();

          const isOpen =
            siteHeader.classList.toggle("mobile-open");

          mobileToggle.classList.toggle(
            "active",
            isOpen
          );

          mobileToggle.setAttribute(
            "aria-expanded",
            isOpen ? "true" : "false"
          );


          document.body.classList.toggle(
            "mobile-menu-open",
            isOpen
          );

        });

      }


      /* =====================================================
         MOBILE ACCORDIONS
      ===================================================== */

      const mobileParents =
        document.querySelectorAll(".mobile-nav-parent");


      mobileParents.forEach(function (parent) {

        if (
          parent.dataset.submenuInitialized === "true"
        ) {
          return;
        }


        parent.dataset.submenuInitialized = "true";


        parent.addEventListener("click", function (event) {

          event.preventDefault();

          const group =
            parent.closest(".mobile-nav-group");

          if (!group) return;


          const isOpen =
            group.classList.toggle("open");


          parent.setAttribute(
            "aria-expanded",
            isOpen ? "true" : "false"
          );

        });

      });


      /* =====================================================
         CLOSE MOBILE MENU AFTER CLICKING NORMAL LINK
      ===================================================== */

      if (
        mobileNavigation &&
        siteHeader &&
        mobileNavigation.dataset.linksInitialized !== "true"
      ) {

        mobileNavigation.dataset.linksInitialized = "true";


        mobileNavigation.addEventListener(
          "click",
          function (event) {

            const link = event.target.closest("a");

            if (!link) return;


            siteHeader.classList.remove(
              "mobile-open"
            );


            if (mobileToggle) {

              mobileToggle.classList.remove(
                "active"
              );

              mobileToggle.setAttribute(
                "aria-expanded",
                "false"
              );

            }


            document.body.classList.remove(
              "mobile-menu-open"
            );

          }
        );

      }

    }


    document.addEventListener(
      "turbo:load",
      initHeader
    );


    document.addEventListener(
      "DOMContentLoaded",
      initHeader
    );

  })();
</script>

