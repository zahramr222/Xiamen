<!DOCTYPE html>
<html lang="en">
  <head>
    <%= display_meta_tags(default_meta_tags) %>

    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%= stylesheet_link_tag "fontawesome/all", "data-turbo-track": "reload" %>
  </head>

  <body>
    <div class="page">

      <%= render "shared/header" %>

      <% if content_for?(:left_sidebar) || content_for?(:right_sidebar) %>

        <div class="grade-page">

          <% if content_for?(:left_sidebar) %>
            <aside class="grade-sidebar">
              <%= yield(:left_sidebar) %>
            </aside>
          <% end %>

          <main class="grade-main">
            <% unless current_page?(root_path) %>
              <%= render "shared/breadcrumbs", breadcrumbs: @breadcrumbs %>
            <% end %>

            <%= yield %>
          </main>

          <% if content_for?(:right_sidebar) %>
            <aside class="grade-related-sidebar">
              <%= yield(:right_sidebar) %>
            </aside>
          <% end %>

        </div>

      <% else %>

        <main class="main">
          <div class="content">
            <% unless current_page?(root_path) %>
              <%= render "shared/breadcrumbs", breadcrumbs: @breadcrumbs %>
            <% end %>

            <%= yield %>
          </div>
        </main>

      <% end %>

      <%= render "shared/footer" %>

    </div>

    <%= yield(:javascript) %>
  </body>
</html>

