<!DOCTYPE html>
<html lang="en">
  <head>
    <%= display_meta_tags(default_meta_tags) %>

    <!-- Organization Structured Data -->
    <script type="application/ld+json">
      <%= raw ERB::Util.json_escape(organization_schema.to_json) %>
    </script>

    <!-- Website Structured Data -->
    <script type="application/ld+json">
      <%= raw ERB::Util.json_escape(website_schema.to_json) %>
    </script>

    <% if @breadcrumbs.present? %>
      <script type="application/ld+json">
        <%= raw ERB::Util.json_escape(breadcrumb_schema(@breadcrumbs).to_json) %>
      </script>
    <% end %>

    <% if defined?(@product) &&
          @product.present? &&
          controller_name == "products" &&
          action_name == "show" %>
      <script type="application/ld+json">
        <%= raw ERB::Util.json_escape(product_schema(@product).to_json) %>
      </script>
    <% end %>

    <% if defined?(@post) &&
          @post.present? &&
          controller_name == "posts" &&
          action_name == "show" %>
      <script type="application/ld+json">
        <%= raw ERB::Util.json_escape(post_schema(@post).to_json) %>
      </script>
    <% end %>

    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%= stylesheet_link_tag "fontawesome/all", "data-turbo-track": "reload" %>
  </head>

  <body>
    <div class="page">

      <%= render "shared/header" %>

      <% if notice.present? %>
        <div class="flash-toast flash-toast-success" data-flash-toast>
          <i class="fa-solid fa-circle-check"></i>
          <span><%= notice %></span>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="flash-toast flash-toast-error" data-flash-toast>
          <i class="fa-solid fa-circle-exclamation"></i>
          <span><%= alert %></span>
        </div>
      <% end %>

      <main class="main">
        <div class="content">
          <%= yield %>
        </div>
      </main>

      <%= render "shared/footer" %>

    </div>
  </body>
</html>