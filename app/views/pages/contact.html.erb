<%# BREADCRUMBS %>
<% @breadcrumbs = [
  { label: "Contact" }
] %>

<%# PAGE TITLE %>
<% content_for(:page_title, "Contact Us | Global Synergy") %>

<div class="contact-page" style="text-align: left !important;">

  <!-- Header -->
  <header class="contact-header">
    <span class="section-label">
      <span class="section-label-line"></span>
      CONTACT US
    </span>
    <h1 class="section-title">Get in <span>Touch</span></h1>
    <p class="contact-subtitle">
      Have a question or want to work with us? Fill out the form below and our team will get back to you within 12 hours.
    </p>
  </header>

  <!-- Contact Content -->
  <div class="contact-content-wrapper">
    
    <!-- Form -->
    <div class="contact-form-wrapper">
      <h3>Write Us</h3>
      <%= form_with model: @contact,
              url: contact_path,
              method: :post,
              class: "contact-form",
                
              data: { turbo: false } do |f| %>

        <div
          style="position:absolute; left:-9999px; width:1px; height:1px; overflow:hidden;"
          aria-hidden="true"
        >
          <%= label_tag :website, "Website" %>
          <%= text_field_tag :website,
                             nil,
                             tabindex: "-1",
                             autocomplete: "off" %>
        </div>

        <div class="contact-form-group">
          <%= f.label :full_name, "Full Name" %>

          <%= f.text_field :full_name,
                           placeholder: "John Doe",
                           required: true,
                           maxlength: 100,
                           autocomplete: "name" %>
        </div>

        <div class="contact-form-group">
          <%= f.label :phone, "Phone Number" %>

          <%= f.telephone_field :phone,
                                placeholder: "+1 234 567 890",
                                required: true,
                                maxlength: 30,
                                autocomplete: "tel" %>
        </div>

        <div class="contact-form-group">
          <%= f.label :message, "Your Message" %>

          <%= f.text_area :message,
                          rows: 5,
                          placeholder: "Tell us how we can help...",
                          required: true,
                          minlength: 10,
                          maxlength: 3000 %>
        </div>

        <div class="contact-captcha">
          <div
            class="cf-turnstile"
            data-sitekey="<%= Rails.application.credentials.dig(
              :cloudflare,
              :turnstile,
              :site_key
            ) %>"
          ></div>
        </div>

        <%= f.submit "Send Message",
                     class: "contact-submit-btn",
                     data: {
                       disable_with: "Sending..."
                     } %>

      <% end %>
    </div>

    <%= render 'inquiry/getintouch' %>
  </div>

</div>

<% content_for :head do %>
  <script
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
  ></script>
<% end %>