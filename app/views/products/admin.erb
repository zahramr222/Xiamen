<!-- =========================================================
       ADMIN: PRODUCT LIST WITH ACTIONS
  ========================================================= -->
  <section class="admin-products-section">
    <div class="admin-products-header">
      <span class="section-label">
        <span class="section-label-line"></span>
        ADMIN
      </span>
      <h3>Product <span>Management</span></h3>
      <p>View, edit, or delete all products in the database.</p>
    </div>

    <div class="admin-products-table-wrapper">
      <table class="admin-products-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Slug</th>
            <th>Grades</th>
            <th>Created At</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @products.present? %>
            <% @products.each do |product| %>
              <tr>
                <td><%= product.id %></td>
                <td><strong><%= product.name %></strong></td>
                <td><code><%= product.slug %></code></td>
                <td><%= product.grades.count %></td>
                <td><%= product.created_at.strftime("%b %d, %Y") %></td>
                <td>
                  <div class="admin-actions">
                    <%= link_to product_path(product), class: "admin-btn admin-btn-show", title: "View" do %>
                      <i class="fa-solid fa-eye"></i>
                    <% end %>
                    <%= link_to edit_product_path(product), class: "admin-btn admin-btn-edit", title: "Edit" do %>
                      <i class="fa-solid fa-pencil"></i>
                    <% end %>
                    <%= link_to product_path(product), 
                        data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this product?" }, 
                        class: "admin-btn admin-btn-delete", 
                        title: "Delete" do %>
                      <i class="fa-solid fa-trash-can"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="admin-empty-state">
                <i class="fa-regular fa-box-open"></i>
                <p>No products found. Create your first product!</p>
                <%= link_to "New Product", new_product_path, class: "btn-primary" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="admin-actions-bottom">
      <%= link_to new_product_path, class: "btn-primary" do %>
        <i class="fa-solid fa-plus"></i>
        New Product
      <% end %>
    </div>
  </section>
  

</div>