<%= form_with(model: product, class: "admin-form") do |form| %>

  <div class="admin-form-header">
    <h1><%= product.persisted? ? "Edit Product" : "New Product" %></h1>
    <p>Manage product information, grades, specifications and SEO.</p>
  </div>

  <% if product.errors.any? %>
    <div class="admin-form-errors">
      <h3><%= pluralize(product.errors.count, "error") %> prevented this product from being saved:</h3>
      <ul>
        <% product.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="admin-form-section">
    <h2 class="admin-form-section-title">General Information</h2>

    <div class="admin-form-group">
      <%= form.label :name, "Product Name" %>
      <%= form.text_field :name, placeholder: "Product name" %>
    </div>

    <div class="admin-form-group">
      <%= form.label :slug, "Slug" %>
      <%= form.text_field :slug, placeholder: "product-url-slug" %>
      <small class="admin-form-help">URL-friendly identifier for this product.</small>
    </div>
  </section>

  <section class="admin-form-section">
    <h2 class="admin-form-section-title">SEO</h2>

    <div class="admin-form-group">
      <%= form.label :meta_title, "SEO Meta Title" %>
      <%= form.text_field :meta_title,
            maxlength: 60,
            placeholder: "e.g. Paraffin Wax Supplier & Exporter | Global Synergy" %>
      <small class="admin-form-help">Recommended: 50–60 characters.</small>
    </div>

    <div class="admin-form-group">
      <%= form.label :meta_description, "SEO Meta Description" %>
      <%= form.text_area :meta_description,
            maxlength: 160,
            rows: 4,
            placeholder: "Write a short description for search engines..." %>
      <small class="admin-form-help">Recommended: 140–160 characters.</small>
    </div>
  </section>

  <section class="admin-form-section">
    <h2 class="admin-form-section-title">Product Relations</h2>

    <div class="admin-form-group">
      <%= form.label :grade_ids, "Grades" %>

      <div class="admin-form-inline">
        <div class="admin-form-inline-field">
          <%= form.collection_select :grade_ids,
                Grade.order(:name),
                :id,
                :name,
                {},
                { multiple: true } %>
        </div>

        <%= link_to "+ New Grade",
              new_grade_path,
              class: "admin-form-secondary-btn" %>
      </div>

      <small class="admin-form-help">Hold Ctrl/Cmd to select multiple grades.</small>
    </div>

    <div class="admin-form-group">
      <%= form.label :specification_id, "Specification" %>

      <div class="admin-form-inline">
        <div class="admin-form-inline-field">
          <%= form.collection_select :specification_id,
                Specification.order(:title),
                :id,
                :title,
                { prompt: "Select Specification" } %>
        </div>

        <%= link_to "+ New Specification",
              new_specification_path,
              class: "admin-form-secondary-btn" %>
      </div>
    </div>
  </section>

  <section class="admin-form-section">
    <h2 class="admin-form-section-title">Content & Media</h2>

    <div class="admin-form-group">
      <%= form.label :content, "Content" %>
      <%= form.text_area :content,
            rows: 15,
            placeholder: "Write product content here..." %>
    </div>

    <div class="admin-form-group">
      <%= form.label :image, "Product Image" %>
      <%= form.file_field :image, class: "admin-form-file", accept: "image/*" %>
    </div>
  </section>

  <section class="admin-form-section">
    <h2 class="admin-form-section-title">Tags</h2>

    <div class="admin-form-group">
      <%= label_tag :tag_names, "Tags" %>
      <%= text_field_tag :tag_names,
            @tag_names,
            placeholder: "plastic, wax, oil" %>
      <small class="admin-form-help">Separate tags with commas (,).</small>
    </div>
  </section>

  <div class="admin-form-actions">
    <%= form.submit class: "admin-form-submit" %>
  </div>

<% end %>