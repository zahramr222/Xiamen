<%# PAGE TITLE %>
<% content_for(:page_title, "Sign Up | Infinity Galaxy") %>

<%# BREADCRUMBS %>
<% @breadcrumbs = [
  { label: "Sign Up" }
] %>

<div class="auth-page">

  <!-- Header -->
  <header class="auth-header">
    <span class="section-label">
      <span class="section-label-line"></span>
      GET STARTED
    </span>
    <h1 class="section-title">
      Create <span>Account</span>
    </h1>
    <p class="auth-subtitle">
      Join Xiamen and start managing your products and content.
    </p>
  </header>

  <!-- Registration Form -->
  <div class="auth-form-wrapper">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>

      <!-- Email -->
      <div class="auth-form-group">
        <%= f.label :email, "Email Address", class: "auth-label" %>
        <div class="auth-input-wrapper">
          <i class="fa-regular fa-envelope"></i>
          <%= f.email_field :email, 
              placeholder: "john@example.com", 
              class: "auth-input", 
              autofocus: true,
              autocomplete: "email",
              required: true %>
        </div>
      </div>

      <!-- Password -->
      <div class="auth-form-group">
        <%= f.label :password, "Password", class: "auth-label" %>
        <div class="auth-input-wrapper">
          <i class="fa-solid fa-lock"></i>
          <%= f.password_field :password, 
              placeholder: "Create a password", 
              class: "auth-input", 
              autocomplete: "new-password",
              required: true %>
        </div>
        <% if @minimum_password_length %>
          <small class="auth-hint"><%= @minimum_password_length %> characters minimum</small>
        <% end %>
      </div>

      <!-- Password Confirmation -->
      <div class="auth-form-group">
        <%= f.label :password_confirmation, "Confirm Password", class: "auth-label" %>
        <div class="auth-input-wrapper">
          <i class="fa-solid fa-lock"></i>
          <%= f.password_field :password_confirmation, 
              placeholder: "Confirm your password", 
              class: "auth-input", 
              autocomplete: "new-password",
              required: true %>
        </div>
      </div>

      <!-- Submit -->
      <div class="auth-actions">
        <%= f.submit "Sign Up", class: "auth-submit-btn" %>
      </div>

    <% end %>

    <!-- Links -->
    <div class="auth-links">
      Already have an account?
      <%= link_to "Log in", new_session_path(resource_name), class: "auth-link" %>
    </div>
  </div>

</div>