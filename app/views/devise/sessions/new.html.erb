<%# PAGE TITLE %>
<% content_for(:page_title, "Login | Infinity Galaxy") %>

<%# BREADCRUMBS %>
<% @breadcrumbs = [
  { label: "Login" }
] %>

<div class="auth-page">

  <!-- Header -->
  <header class="auth-header">
    <span class="section-label">
      <span class="section-label-line"></span>
      WELCOME BACK
    </span>
    <h1 class="section-title">
      Log In to <span>Your Account</span>
    </h1>
    <p class="auth-subtitle">
      Access your account and manage your content.
    </p>
  </header>

  <!-- Login Form -->
  <div class="auth-form-wrapper">
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>

      <!-- Email -->
      <div class="auth-form-group">
        <%= f.label :email, "Email Address", class: "auth-label" %>
        <div class="auth-input-wrapper">
          <i class="fa-regular fa-envelope"></i>
          <%= f.email_field :email, 
              placeholder: "john@example.com", 
              class: "auth-input", 
              autofocus: true,
              autocomplete: "email",
              required: true %>
        </div>
      </div>

      <!-- Password -->
      <div class="auth-form-group">
        <%= f.label :password, "Password", class: "auth-label" %>
        <div class="auth-input-wrapper">
          <i class="fa-solid fa-lock"></i>
          <%= f.password_field :password, 
              placeholder: "Enter your password", 
              class: "auth-input", 
              autocomplete: "current-password",
              required: true %>
        </div>
      </div>

      <!-- Remember Me -->
      <% if devise_mapping.rememberable? %>
        <div class="auth-remember">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, "Remember me" %>
        </div>
      <% end %>

      <!-- Submit -->
      <div class="auth-actions">
        <%= f.submit "Log In", class: "auth-submit-btn" %>
      </div>

    <% end %>

    <!-- Links -->
    <div class="auth-links">
      <%= link_to "Forgot your password?", new_password_path(resource_name), class: "auth-link" %>
      <span class="auth-divider">|</span>
      <%= link_to "Create an account", new_registration_path(resource_name), class: "auth-link" %>
    </div>
  </div>

</div>