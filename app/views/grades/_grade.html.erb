<% grade = local_assigns[:grade] %>

<!-- HERO -->
<section class="grade-hero" id="overview">
  <div class="grade-image-wrapper">
    <% if grade.try(:image).present? && grade.image.attached? %>
      <%= image_tag grade.image, alt: grade.name, class: "grade-image" %>
    <% else %>
      <img src="https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=1400&q=85" alt="<%= grade.name %>" class="grade-image">
    <% end %>
  </div>

  <div class="grade-introduction">
    <div class="grade-eyebrow">BITUMEN GRADE</div>
    <h1><%= grade.name %></h1>
    <p class="grade-summary"><%= grade.try(:summary) || "High-quality petroleum bitumen grade supplied for industrial, road construction and infrastructure applications with reliable international delivery and flexible packing options." %></p>
  </div>
</section>

<!-- OVERVIEW -->
<section class="grade-section">
  <div class="grade-section-heading">
    <span class="grade-section-number">01</span>
    <div>
      <span class="grade-section-label">OVERVIEW</span>
      <h2><%= grade.name %></h2>
    </div>
  </div>

  <div class="grade-overview-table">
    <div class="grade-overview-row">
      <span>Type</span>
      <strong><%= grade.try(:product_type) || "Aryl Hydrocarbon Bitumen" %></strong>
    </div>
    <div class="grade-overview-row">
      <span>Feed Stock</span>
      <strong><%= grade.try(:feed_stock) || "Crude Oil" %></strong>
    </div>
    <div class="grade-overview-row">
      <span>HS Code</span>
      <strong><%= grade.try(:hs_code) || "27132000" %></strong>
    </div>
    <div class="grade-overview-row">
      <span>Other Names</span>
      <strong><%= grade.try(:other_names) || "Bitumen 60/80" %></strong>
    </div>
    <div class="grade-overview-row">
      <span>Spot Test</span>
      <strong><%= grade.try(:spot_test) || "Negative" %></strong>
    </div>
    <div class="grade-overview-row">
      <span>Inspection</span>
      <strong><%= grade.try(:inspection) || "Included" %></strong>
    </div>
    <div class="grade-overview-row">
      <span>Delivery Term</span>
      <strong><%= grade.try(:delivery_term) || "FOB-CFR-CIF" %></strong>
    </div>
    <div class="grade-overview-row">
      <span>Production & Loading</span>
      <strong><%= grade.try(:production_loading) || "Maximum 3 Weeks" %></strong>
    </div>
    <div class="grade-overview-row">
      <span>Payment Term</span>
      <strong><%= grade.try(:payment_term) || "TT Method" %></strong>
    </div>
    <div class="grade-overview-row">
      <span>Supply Capacity</span>
      <strong><%= grade.try(:supply_capacity) || "30,000 MT / Month" %></strong>
    </div>
    <div class="grade-overview-row">
      <span>Marking</span>
      <strong><%= grade.try(:marking) || "Customized based on customer request" %></strong>
    </div>
    <div class="grade-overview-row">
      <span>Packing</span>
      <strong><%= grade.try(:packing_options_list) || "Jumbo Bag · Flexi Tank" %></strong>
    </div>
  </div>
</section>

<!-- SPECIFICATION -->
<section class="grade-section" id="specification">
  <div class="grade-section-heading">
    <span class="grade-section-number">02</span>
    <div>
      <span class="grade-section-label">SPECIFICATION</span>
      <h2><%= grade.name %> Specifications</h2>
    </div>
  </div>

  <div class="grade-specification-table-wrapper">
    <table class="grade-specification-table">
      <thead>
        <tr>
          <th>Specification</th>
          <th>Unit</th>
          <th>Value</th>
          <th>Test Method</th>
        </tr>
      </thead>
      <tbody>
        <% if grade.try(:specifications).present? %>
          <% grade.specifications.each do |spec| %>
            <tr>
              <td><%= spec[:name] %></td>
              <td><%= spec[:unit] %></td>
              <td><%= spec[:value] %></td>
              <td><%= spec[:test_method] %></td>
            </tr>
          <% end %>
        <% else %>
          <!-- Default specifications if none exist -->
          <tr>
            <td>Penetration 25°C</td>
            <td>0.1mm</td>
            <td>60–80</td>
            <td>ASTM D5</td>
          </tr>
          <tr>
            <td>Softening Point, @ 135°C</td>
            <td>°C</td>
            <td>Min 42</td>
            <td>ASTM D36</td>
          </tr>
          <tr>
            <td>Density, 15°C</td>
            <td>kg/m³</td>
            <td>1.000 / 1.060</td>
            <td>ASTM D70</td>
          </tr>
          <tr>
            <td>Ductility, 15°C, 5cm/min</td>
            <td>cm</td>
            <td>Min 100</td>
            <td>ASTM D113</td>
          </tr>
          <tr>
            <td>Flash Point</td>
            <td>°C</td>
            <td>Min 260</td>
            <td>ASTM D92</td>
          </tr>
          <tr>
            <td>Solubility in Trichloroethylene</td>
            <td>WT%</td>
            <td>Min 99.5</td>
            <td>ASTM D2042</td>
          </tr>
          <tr class="grade-table-subheading">
            <td colspan="4">AFTER TFOT AT 163°C — ASTM D1754</td>
          </tr>
          <tr>
            <td>Loss of Weight</td>
            <td>-</td>
            <td>-0.8 / 0.8</td>
            <td>ASTM D1754</td>
          </tr>
          <tr>
            <td>Retained Penetration Ratio</td>
            <td>%</td>
            <td>Min 61</td>
            <td>ASTM D5</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<!-- MSDS -->
<section class="grade-section" id="msds">
  <div class="grade-section-heading">
    <span class="grade-section-number">03</span>
    <div>
      <span class="grade-section-label">DOCUMENTATION</span>
      <h2>Material Safety Data Sheet</h2>
    </div>
  </div>

  <div class="grade-msds-card">
    <div class="grade-msds-icon">
      <i class="fa-regular fa-file-pdf"></i>
    </div>
    <div class="grade-msds-content">
      <span>PDF DOCUMENT</span>
      <h3><%= grade.name %> MSDS</h3>
      <p>Material Safety Data Sheet for <%= grade.name %>.</p>
    </div>
    <% if grade.try(:msds_file).present? && grade.msds_file.attached? %>
      <%= link_to grade.msds_file, class: "grade-msds-download", aria_label: "Download MSDS" do %>
        <i class="fa-solid fa-download"></i>
      <% end %>
    <% else %>
      <a href="#" class="grade-msds-download" aria-label="Download MSDS">
        <i class="fa-solid fa-download"></i>
      </a>
    <% end %>
  </div>
</section>

<!-- PACKING -->
<section class="grade-section" id="packing">
  <div class="grade-section-heading">
    <span class="grade-section-number">04</span>
    <div>
      <span class="grade-section-label">PACKING</span>
      <h2><%= grade.name %> Packing</h2>
    </div>
  </div>

  <div class="grade-packing-grid">
    <% if grade.try(:packing_options).present? %>
      <% grade.packing_options.each do |packing| %>
        <article class="grade-packing-card">
          <div class="grade-packing-image">
            <% if packing[:image].present? %>
              <%= image_tag packing[:image], alt: "#{packing[:name]} Packing", loading: "lazy" %>
            <% else %>
              <img src="https://images.unsplash.com/photo-1586528116493-da8b6e2e7c43?auto=format&fit=crop&w=1000&q=85" alt="<%= packing[:name] %> Packing" loading="lazy">
            <% end %>
          </div>
          <div class="grade-packing-content">
            <span class="grade-packing-label">PACKING TYPE</span>
            <h3><%= packing[:name] %></h3>
            <p><%= packing[:description] %></p>
          </div>
        </article>
      <% end %>
    <% else %>
      <!-- Default packing options -->
      <article class="grade-packing-card">
        <div class="grade-packing-image">
          <img src="https://images.unsplash.com/photo-1586528116493-da8b6e2e7c43?auto=format&fit=crop&w=1000&q=85" alt="Jumbo Bag Packing" loading="lazy">
        </div>
        <div class="grade-packing-content">
          <span class="grade-packing-label">PACKING TYPE</span>
          <h3>Jumbo Bag</h3>
          <p>Two types of jumbo bags are available: 1 MT in a steel cage on a wooden pallet, 300 kg and 1.3 MT options are also available according to customer requirements.</p>
        </div>
      </article>
      <article class="grade-packing-card">
        <div class="grade-packing-image">
          <img src="https://images.unsplash.com/photo-1494412574643-ff11b0a5c1c3?auto=format&fit=crop&w=1000&q=85" alt="Flexi Tank Packing" loading="lazy">
        </div>
        <div class="grade-packing-content">
          <span class="grade-packing-label">PACKING TYPE</span>
          <h3>Flexi Tank</h3>
          <p>Flexi tanks are available with capacities ranging from 14,000 to 24,000 liters. The tank is made from Polyethylene or Polypropylene.</p>
        </div>
      </article>
    <% end %>
  </div>
</section>

<!-- DESCRIPTION -->
<section class="grade-description">
  <span class="grade-section-label">GRADE INFORMATION</span>
  <h2>Buy <%= grade.name %> from Infinity Galaxy</h2>
  <h3>Infinity Galaxy, <%= grade.name %> Supplier</h3>
  <p><%= grade.try(:description).presence || "We are supplying #{grade.name}, one of the most popular grades of bitumen, in both jumbo bags and flexitanks. Our sales experts will guide you about the required documents for customs, market conditions and the steps involved in finalizing your orders." %></p>
</section>

<%= render 'shared/inquiry' %>