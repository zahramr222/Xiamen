<%# BREADCRUMBS %>
<% @breadcrumbs = [
  { label: "Posts" }
] %>

<%# PAGE TITLE %>
<% content_for(:page_title, "Posts | Infinity Galaxy") %>

<%# LEFT SIDEBAR %>
<% content_for(:left_sidebar) do %>
  <%= render "shared/left_sidebar",
    title: "Posts",
    nav_items: [
      { id: "reports", label: "Reports" },
      { id: "articles", label: "Articles" },
      { id: "news", label: "News" },
      { id: "applications", label: "Applications" }
    ],
    order_url: "#{root_path}#inquiry",
    order_text: "Send Inquiry"
  %>
<% end %>

<div class="posts-page">

  <!-- =====================================================
       REPORTS SECTION
  ====================================================== -->
  <% if @reports.present? %>
    <section class="reports-section">
      <div class="reports-container">
        <div class="reports-header">
          <div class="reports-heading">
            <span class="reports-label">MARKET INTELLIGENCE</span>
            <h2>Latest <span>Reports.</span></h2>
          </div>
          <p>Stay informed with the latest market insights, pricing trends and global trade developments from our experts.</p>
        </div>
        <div class="reports-layout">
          <article class="featured-report">
            <div class="featured-report-image">
              <% if @reports.first.image.attached? %>
                <%= image_tag @reports.first.image, alt: @reports.first.title %>
              <% else %>
                <img src="https://images.unsplash.com/photo-1494412574643-ff11b0a5c1c3?auto=format&fit=crop&w=1400&q=85" alt="Featured Report">
              <% end %>
              <div class="featured-report-overlay">
                <span>WEEKLY REPORT</span>
                <i class="fa-solid fa-arrow-up-right"></i>
              </div>
            </div>
            <div class="featured-report-content">
              <div class="report-meta">
                <span class="report-category"><%= @reports.first.post_type || "Report" %></span>
                <span class="report-date"><%= @reports.first.updated_at.strftime("%b %d, %Y") %></span>
              </div>
              <h3><%= @reports.first.title %></h3>
              <p><%= truncate(@reports.first.summery || @reports.first.content, length: 135) %></p>
              <%= link_to post_path(@reports.first), class: "report-read-link" do %>
                Read Report <i class="fa-solid fa-arrow-right"></i>
              <% end %>
            </div>
          </article>
          
          <div class="reports-list">
            <% @reports.drop(1).each do |po| %>
              <article class="report-item">
                <div class="report-item-image">
                  <% if po.image.attached? %>
                    <%= image_tag po.image, alt: po.title %>
                  <% else %>
                    <img src="https://images.unsplash.com/photo-1450101499163-c8848c66ca85?auto=format&fit=crop&w=700&q=85" alt="<%= po.title %>">
                  <% end %>
                </div>
                <div class="report-item-content">
                  <div class="report-item-top">
                    <span><%= po.post_type&.upcase || "MARKET REPORT" %></span>
                    <time><%= po.updated_at.strftime("%b %d, %Y") %></time>
                  </div>
                  <h3><%= po.title %></h3>
                  <%= link_to post_path(po), class: "report-read-link" do %>
                    Read Report <i class="fa-solid fa-arrow-right"></i>
                  <% end %>
                </div>
              </article>
            <% end %>
          </div>
        </div>
      </div>
    </section>
  <% end %>

  <!-- =====================================================
       ARTICLES SECTION
  ====================================================== -->
  <% if @articles.present? %>
    <section class="reports-section">
      <div class="reports-container">
        <div class="reports-header">
          <div class="reports-heading">
            <span class="reports-label">INSIGHTS</span>
            <h2>Latest <span>Articles.</span></h2>
          </div>
          <p>Read our latest articles on industry trends, expert insights, and market analysis.</p>
        </div>
        <div class="reports-layout">
          <article class="featured-report">
            <div class="featured-report-image">
              <% if @articles.first.image.attached? %>
                <%= image_tag @articles.first.image, alt: @articles.first.title %>
              <% else %>
                <img src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=1400&q=85" alt="Featured Article">
              <% end %>
              <div class="featured-report-overlay">
                <span>FEATURED</span>
                <i class="fa-solid fa-arrow-up-right"></i>
              </div>
            </div>
            <div class="featured-report-content">
              <div class="report-meta">
                <span class="report-category"><%= @articles.first.post_type || "Article" %></span>
                <span class="report-date"><%= @articles.first.updated_at.strftime("%b %d, %Y") %></span>
              </div>
              <h3><%= @articles.first.title %></h3>
              <p><%= truncate(@articles.first.summery || @articles.first.content, length: 135) %></p>
              <%= link_to post_path(@articles.first), class: "report-read-link" do %>
                Read Article <i class="fa-solid fa-arrow-right"></i>
              <% end %>
            </div>
          </article>
          
          <div class="reports-list">
            <% @articles.drop(1).each do |po| %>
              <article class="report-item">
                <div class="report-item-image">
                  <% if po.image.attached? %>
                    <%= image_tag po.image, alt: po.title %>
                  <% else %>
                    <img src="https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?auto=format&fit=crop&w=700&q=85" alt="<%= po.title %>">
                  <% end %>
                </div>
                <div class="report-item-content">
                  <div class="report-item-top">
                    <span><%= po.post_type&.upcase || "ARTICLE" %></span>
                    <time><%= po.updated_at.strftime("%b %d, %Y") %></time>
                  </div>
                  <h3><%= po.title %></h3>
                  <%= link_to post_path(po), class: "report-read-link" do %>
                    Read Article <i class="fa-solid fa-arrow-right"></i>
                  <% end %>
                </div>
              </article>
            <% end %>
          </div>
        </div>
      </div>
    </section>
  <% end %>

  <!-- =====================================================
       NEWS SECTION
  ====================================================== -->
  <% if @news.present? %>
    <section class="reports-section">
      <div class="reports-container">
        <div class="reports-header">
          <div class="reports-heading">
            <span class="reports-label">UPDATES</span>
            <h2>Latest <span>News.</span></h2>
          </div>
          <p>Stay updated with the latest company news, industry announcements, and product updates.</p>
        </div>
        <div class="reports-layout">
          <article class="featured-report">
            <div class="featured-report-image">
              <% if @news.first.image.attached? %>
                <%= image_tag @news.first.image, alt: @news.first.title %>
              <% else %>
                <img src="https://images.unsplash.com/photo-1565793298595-6a879b1d9492?auto=format&fit=crop&w=1400&q=85" alt="Featured News">
              <% end %>
              <div class="featured-report-overlay">
                <span>BREAKING</span>
                <i class="fa-solid fa-arrow-up-right"></i>
              </div>
            </div>
            <div class="featured-report-content">
              <div class="report-meta">
                <span class="report-category"><%= @news.first.post_type || "News" %></span>
                <span class="report-date"><%= @news.first.updated_at.strftime("%b %d, %Y") %></span>
              </div>
              <h3><%= @news.first.title %></h3>
              <p><%= truncate(@news.first.summery || @news.first.content, length: 135) %></p>
              <%= link_to post_path(@news.first), class: "report-read-link" do %>
                Read News <i class="fa-solid fa-arrow-right"></i>
              <% end %>
            </div>
          </article>
          
          <div class="reports-list">
            <% @news.drop(1).each do |po| %>
              <article class="report-item">
                <div class="report-item-image">
                  <% if po.image.attached? %>
                    <%= image_tag po.image, alt: po.title %>
                  <% else %>
                    <img src="https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=700&q=85" alt="<%= po.title %>">
                  <% end %>
                </div>
                <div class="report-item-content">
                  <div class="report-item-top">
                    <span><%= po.post_type&.upcase || "NEWS" %></span>
                    <time><%= po.updated_at.strftime("%b %d, %Y") %></time>
                  </div>
                  <h3><%= po.title %></h3>
                  <%= link_to post_path(po), class: "report-read-link" do %>
                    Read News <i class="fa-solid fa-arrow-right"></i>
                  <% end %>
                </div>
              </article>
            <% end %>
          </div>
        </div>
      </div>
    </section>
  <% end %>

  <!-- =====================================================
       APPLICATIONS SECTION
  ====================================================== -->
  <% if @applications.present? %>
    <section class="reports-section">
      <div class="reports-container">
        <div class="reports-header">
          <div class="reports-heading">
            <span class="reports-label">APPLICATIONS</span>
            <h2>Industry <span>Applications.</span></h2>
          </div>
          <p>Explore how our products are used across various industries and applications worldwide.</p>
        </div>
        <div class="reports-layout">
          <article class="featured-report">
            <div class="featured-report-image">
              <% if @applications.first.image.attached? %>
                <%= image_tag @applications.first.image, alt: @applications.first.title %>
              <% else %>
                <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1400&q=85" alt="Featured Application">
              <% end %>
              <div class="featured-report-overlay">
                <span>APPLICATION</span>
                <i class="fa-solid fa-arrow-up-right"></i>
              </div>
            </div>
            <div class="featured-report-content">
              <div class="report-meta">
                <span class="report-category"><%= @applications.first.post_type || "Application" %></span>
                <span class="report-date"><%= @applications.first.updated_at.strftime("%b %d, %Y") %></span>
              </div>
              <h3><%= @applications.first.title %></h3>
              <p><%= truncate(@applications.first.summery || @applications.first.content, length: 135) %></p>
              <%= link_to post_path(@applications.first), class: "report-read-link" do %>
                Learn More <i class="fa-solid fa-arrow-right"></i>
              <% end %>
            </div>
          </article>
          
          <div class="reports-list">
            <% @applications.drop(1).each do |po| %>
              <article class="report-item">
                <div class="report-item-image">
                  <% if po.image.attached? %>
                    <%= image_tag po.image, alt: po.title %>
                  <% else %>
                    <img src="https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?auto=format&fit=crop&w=700&q=85" alt="<%= po.title %>">
                  <% end %>
                </div>
                <div class="report-item-content">
                  <div class="report-item-top">
                    <span><%= po.post_type&.upcase || "APPLICATION" %></span>
                    <time><%= po.updated_at.strftime("%b %d, %Y") %></time>
                  </div>
                  <h3><%= po.title %></h3>
                  <%= link_to post_path(po), class: "report-read-link" do %>
                    Learn More <i class="fa-solid fa-arrow-right"></i>
                  <% end %>
                </div>
              </article>
            <% end %>
          </div>
        </div>
      </div>
    </section>
  <% end %>

  <!-- =====================================================
       EMPTY STATE
  ====================================================== -->
  <% if @reports.empty? && @articles.empty? && @news.empty? && @applications.empty? %>
    <div class="posts-empty">
      <i class="fa-regular fa-newspaper"></i>
      <h3>No Posts Yet</h3>
      <p>Check back soon for our latest articles, reports, news, and applications.</p>
    </div>
  <% end %>

  <!-- =====================================================
       ADMIN TABLE
  ====================================================== -->
  <div class="posts-admin" style="margin-top: 70px; padding-top: 40px; border-top: 2px solid #e9eaee;">
    <h2>Manage Posts</h2>
    <p><%= link_to "New Post", new_post_path, class: "btn-primary" %></p>

    <table border="1" cellpadding="8" style="width: 100%; border-collapse: collapse; margin-top: 20px;">
      <thead>
        <tr>
          <th>Title</th>
          <th>Slug</th>
          <th>Type</th>
          <th>Tags</th>
          <th>Summary</th>
          <th>Image</th>
          <th colspan="3">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @posts.each do |post| %>
          <tr>
            <td><%= post.title %></td>
            <td><%= post.slug %></td>
            <td><%= post.post_type %></td>
            <td><%= post.tags.pluck(:name).join(", ") %></td>
            <td><%= truncate(post.summery || post.content, length: 50) %></td>
            <td>
              <% if post.image.attached? %>
                <%= image_tag post.image, width: 50 %>
              <% end %>
            </td>
            <td><%= link_to "Show", post %></td>
            <td><%= link_to "Edit", edit_post_path(post) %></td>
            <td>
              <%= link_to "Delete",
                          post,
                          data: {
                            turbo_method: :delete,
                            turbo_confirm: "Are you sure?"
                          } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

</div>