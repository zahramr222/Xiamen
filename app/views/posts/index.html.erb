
<section class="posts-page">

  <%# =====================================================
      HERO
  ====================================================== %>

  <section class="posts-hero-wrapper">
    <div class="posts-hero">

      <div class="posts-hero-content">

        <span class="posts-eyebrow">
          XIAMEN INSIGHTS
        </span>

        <h1>
          Insights, Reports &
          <span>Industry Updates</span>
        </h1>

        <p>
          Market reports, industry articles, news and practical insights
          covering bitumen, petroleum products and global trade.
        </p>

      </div>

      <div class="posts-hero-decoration" aria-hidden="true">
        <div class="posts-hero-circle posts-hero-circle-one"></div>
        <div class="posts-hero-circle posts-hero-circle-two"></div>
      </div>

    </div>
  </section>


  <%# =====================================================
      EXPLORE / ALL CONTENT
  ====================================================== %>

  <section class="posts-all" id="posts-explore">

    <div class="posts-section-heading">

      <span class="posts-section-label">
        EXPLORE
      </span>

      <h2>
        <% if @current_type.present? %>
          <%= @current_type.titleize %>
        <% else %>
          All <span>Content</span>
        <% end %>
      </h2>

      <p class="posts-section-description">
        Browse our latest reports, articles, industry news and product application insights.
      </p>

    </div>


    <%# =====================================================
        FILTERS
    ====================================================== %>

    <nav class="posts-filters" aria-label="Post categories">

      <%= link_to "#{posts_path}#posts-explore",
          class: "posts-filter #{'active' if @current_type.blank?}" do %>
        All
      <% end %>

      <%= link_to "#{posts_path(type: 'reports')}#posts-explore",
          class: "posts-filter #{'active' if @current_type == 'reports'}" do %>
        Reports
      <% end %>

      <%= link_to "#{posts_path(type: 'articles')}#posts-explore",
          class: "posts-filter #{'active' if @current_type == 'articles'}" do %>
        Articles
      <% end %>

      <%= link_to "#{posts_path(type: 'news')}#posts-explore",
          class: "posts-filter #{'active' if @current_type == 'news'}" do %>
        News
      <% end %>

      <%= link_to "#{posts_path(type: 'applications')}#posts-explore",
          class: "posts-filter #{'active' if @current_type == 'applications'}" do %>
        Applications
      <% end %>

    </nav>


    <%# =====================================================
        POSTS GRID
    ====================================================== %>

    <% if @posts.any? %>

      <div class="posts-grid">

        <% @posts.each do |post| %>

          <article class="post-card">

            <%= link_to post_path(post),
                class: "post-card-image",
                aria: { label: post.title } do %>

              <% if post.image.attached? %>

                <%= image_tag post.image,
                    alt: post.title,
                    loading: "lazy" %>

              <% else %>

                <div class="post-card-image-placeholder">
                  <i class="fa-regular fa-image"></i>
                </div>

              <% end %>

              <span class="post-card-type">
                <%= post.post_type %>
              </span>

            <% end %>


            <div class="post-card-content">

              <div class="post-card-meta">

                <span>
                  <%= post.post_type %>
                </span>

                <time datetime="<%= post.created_at.to_date %>">
                  <%= post.created_at.strftime("%b %d, %Y") %>
                </time>

              </div>


              <h3>
                <%= link_to post.title, post_path(post) %>
              </h3>


              <% if post.summery.present? %>

                <p>
                  <%= truncate(post.summery, length: 135) %>
                </p>

              <% elsif post.content.present? %>

                <p>
                  <%= truncate(
                    strip_tags(post.content),
                    length: 135
                  ) %>
                </p>

              <% end %>


              <%= link_to post_path(post),
                  class: "post-read-more" do %>

                <span>Read More</span>

                <i class="fa-solid fa-arrow-right"></i>

              <% end %>

            </div>

          </article>

        <% end %>

      </div>


      <%# =====================================================
          PAGINATION
      ====================================================== %>

      <% if @pagy.pages > 1 %>

        <div class="posts-pagination-wrapper">

          <nav
            class="posts-pagination"
            aria-label="Posts pagination"
          >
            <%== @pagy.series_nav %>
          </nav>

        </div>

      <% end %>


    <% else %>

      <div class="posts-empty">

        <div class="posts-empty-icon">
          <i class="fa-regular fa-file-lines"></i>
        </div>

        <h3>No Content Available</h3>

        <p>
          There are currently no posts available in this category.
        </p>

        <%= link_to "View All Content",
            "#{posts_path}#posts-explore",
            class: "posts-empty-button" %>

      </div>

    <% end %>

  </section>

</section>
