<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1>Packings</h1>

        <%= link_to "New Packing",
        new_packing_path,
        class: "btn btn-primary" %>

    </div>

    <table class="table table-bordered table-hover">

        <thead>

            <tr>

                <th>Name</th>

                <th>Specification</th>

                <th>Actions</th>

            </tr>

        </thead>

        <tbody>

            <% @packings.each do |packing| %>

            <tr>

                <td>
                    <%= packing.name %>
                </td>

                <td>
                    <%= packing.specification&.title || "-" %>
                </td>

                <td>

                    <%= link_to "Show",
                    packing_path(packing),
                    class: "btn btn-info btn-sm" %>

                    <%= link_to "Edit",
                    edit_packing_path(packing),
                    class: "btn btn-warning btn-sm" %>

                    <%= button_to "Delete",
                    packing_path(packing),
                    method: :delete,
                    form: { style: "display:inline;" },
                    data: { turbo_confirm: "Are you sure?" },
                    class: "btn btn-danger btn-sm" %>
                    
                    <% if packing.image.attached? %>
                    <%= image_tag packing.image, width: 100 %>
                    <% end %>


                </td>

            </tr>

            <% end %>

        </tbody>

    </table>

</div>