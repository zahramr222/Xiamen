<h1>Packings</h1>

<%= link_to "New Packing", new_packing_path %>

<table>
  <tr>
    <th>Name</th>
    <th>Grades</th>
    <th>Tags</th>
    <th>Content Preview</th>
    <th>Image</th>
    <th>Actions</th>
  </tr>

  <% @packings.each do |packing| %>
    <tr>
      <td><%= packing.name %></td>
      <td>
        <% if packing.grades.present? %>
          <%= packing.grades.pluck(:name).join(", ") %>
        <% else %>
          <span style="color: #999;">No grades</span>
        <% end %>
      </td>
      <td>
        <% if packing.tags.present? %>
          <%= packing.tags.pluck(:name).join(", ") %>
        <% else %>
          <span style="color: #999;">No tags</span>
        <% end %>
      </td>
      <td>
        <% if packing.content.present? %>
          <%= truncate(strip_tags(packing.content), length: 80) %>
        <% else %>
          <span style="color: #999;">No content</span>
        <% end %>
      </td>
      <td>
        <% if packing.image.attached? %>
          <%= image_tag packing.image, width: 50 %>
        <% end %>
      </td>
      <td>
        <%= link_to "Show", packing_path(packing) %>
        <%= link_to "Edit", edit_packing_path(packing) %>
        <%= link_to "Delete",
                    packing_path(packing),
                    data: { turbo_method: :delete,
                            turbo_confirm: "Are you sure?" } %>
      </td>
    </tr>
  <% end %>
</table>