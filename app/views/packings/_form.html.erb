<%= form_with(model: @packing, local: true, class: "admin-form") do |form| %>

  <div class="admin-form-header">
    <h1><%= @packing.persisted? ? "Edit Packing" : "New Packing" %></h1>
    <p>Manage packing information, specification, content and SEO.</p>
  </div>

  <% if @packing.errors.any? %>
    <div class="admin-form-errors">
      <h3><%= pluralize(@packing.errors.count, "error") %> prevented this packing from being saved:</h3>
      <ul>
        <% @packing.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="admin-form-section">
    <h2 class="admin-form-section-title">General Information</h2>

    <div class="admin-form-group">
      <%= form.label :name, "Packing Name" %>
      <%= form.text_field :name, placeholder: "Packing name" %>
    </div>

    <div class="admin-form-group">
      <%= form.label :slug, "Slug" %>
      <%= form.text_field :slug, placeholder: "packing-url-slug" %>
    </div>
  </section>

  <section class="admin-form-section">
    <h2 class="admin-form-section-title">SEO</h2>

    <div class="admin-form-group">
      <%= form.label :meta_title, "SEO Meta Title" %>
      <%= form.text_field :meta_title,
            maxlength: 60,
            placeholder: "SEO title for this page" %>
      <small class="admin-form-help">Recommended: 50–60 characters.</small>
    </div>

    <div class="admin-form-group">
      <%= form.label :meta_description, "SEO Meta Description" %>
      <%= form.text_area :meta_description,
            maxlength: 160,
            rows: 4,
            placeholder: "SEO description for this page" %>
      <small class="admin-form-help">Recommended: 140–160 characters.</small>
    </div>
  </section>

  <section class="admin-form-section">
    <h2 class="admin-form-section-title">Specification</h2>

    <div class="admin-form-group">
      <%= form.label :specification_id, "Specification" %>

      <div class="admin-form-inline">
        <div class="admin-form-inline-field">
          <%= form.collection_select(
                :specification_id,
                Specification.order(:title),
                :id,
                :title,
                { include_blank: "Select a specification" }
              ) %>
        </div>

        <%= link_to "+ New Specification",
              new_specification_path,
              class: "admin-form-secondary-btn" %>
      </div>
    </div>
  </section>

  <section class="admin-form-section">
    <h2 class="admin-form-section-title">Content & Media</h2>

    <div class="admin-form-group">
      <%= form.label :content, "Content" %>
      <%= form.text_area :content,
            rows: 15,
            placeholder: "Write packing content here..." %>
    </div>

    <div class="admin-form-group">
      <%= form.label :image, "Packing Image" %>
      <%= form.file_field :image, class: "admin-form-file", accept: "image/*" %>
    </div>
  </section>

  <section class="admin-form-section">
    <h2 class="admin-form-section-title">Tags</h2>

    <div class="admin-form-group">
      <%= label_tag :tag_names, "Tags" %>
      <%= text_field_tag :tag_names,
            @tag_names,
            placeholder: "25kg, bag, industrial, bulk" %>
      <small class="admin-form-help">Separate tags with commas (,).</small>
    </div>
  </section>

  <div class="admin-form-actions">
    <%= form.submit class: "admin-form-submit" %>
  </div>

<% end %>