<%# BREADCRUMBS %>
<% @breadcrumbs = [
  { label: "Packings", path: packings_path },
  { label: @packing.name }
] %>


<div class="packing-show">

  <!-- Header -->
  <header class="packing-header">
    <div class="packing-header-content">
      <span class="section-label">
        <span class="section-label-line"></span>
        PACKING
      </span>
      <h1 class="section-title">
        <span><%= @packing.name %></span>
      </h1>
      <div class="packing-meta">
        <span class="packing-meta-item">
          <i class="fa-regular fa-calendar"></i>
          <%= @packing.created_at.strftime("%B %d, %Y") %>
        </span>
        <% if @packing.grades.present? %>
          <span class="packing-meta-item">
            <i class="fa-solid fa-flask"></i>
            Grades: 
            <%= @packing.grades.map { |g| link_to(g.name, grade_path(g)) }.join(", ").html_safe %>
          </span>
        <% end %>
        <% if @packing.tags.present? %>
          <span class="packing-meta-item">
            <i class="fa-solid fa-tags"></i>
            <%= @packing.tags.pluck(:name).join(", ") %>
          </span>
        <% end %>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <div class="packing-content-wrapper">
    
    <!-- Image -->
    <% if @packing.image.attached? %>
      <div class="packing-image">
        <%= image_tag @packing.image, alt: @packing.name %>
      </div>
    <% end %>

    <!-- Content -->
    <div class="packing-content">
      <% if @packing.content.present? %>
        <%= @packing.content.html_safe %>
      <% else %>
        <p class="text-muted">No description available for this packing.</p>
      <% end %>
    </div>

  </div>

  <!-- Back Link -->
  <div class="packing-actions">
    <%= link_to packings_path, class: "packing-back-btn" do %>
      <i class="fa-solid fa-arrow-left"></i>
      Back to Packings
    <% end %>
    <%= link_to edit_packing_path(@packing), class: "packing-edit-btn" do %>
      <i class="fa-solid fa-pencil"></i>
      Edit Packing
    <% end %>
  </div>

</div>