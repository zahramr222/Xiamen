<!-- PRODUCTS SECTION (NEWS) -->
<section class="news-section">
  <div class="news-header">
    <div class="news-header-left">
      <div class="partners-label">
        <span class="partners-label-line"></span> PRODUCTS
      </div>
      <h2>Our <span>Products</span></h2>
    </div>
    <a href="<%= products_path %>" class="news-view-all">
      View all <i class="fas fa-arrow-up-right-from-square"></i>
    </a>
  </div>

  <div class="news-grid">
    <!-- Product 1 -->
    <article class="news-item">
      <div class="news-image">
        <% if @products[0]&.image&.attached? %>
          <%= image_tag @products[0].image, alt: @products[0].name %>
        <% else %>
          <img src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=900&q=80" alt="<%= @products[0]&.name || 'Product' %>">
        <% end %>
        <span class="news-category"><%= @products[0]&.name&.upcase || "PRODUCT" %></span>
      </div>
      <div class="news-content">
        <div class="news-meta">
          <span>PRODUCT</span>
          <span class="news-dot"></span>
          <span>EXPORT</span>
        </div>
        <h3><%= @products[0]&.name || "Product" %></h3>
        <p><%= @products[0]&.content.present? ? truncate(@products[0].content, length: 100) : "Premium product supplier for global projects" %></p>
        <a href="<%= product_path(@products[0]) if @products[0] %>" class="news-read">
          View product <i class="fas fa-arrow-right"></i>
        </a>
      </div>
    </article>

