<!-- PRODUCTS SECTION (NEWS) -->
<section class="news-section">
  <div class="news-header">
    <div class="news-header-left">
      <div class="partners-label">
        <span class="partners-label-line"></span>
        PRODUCTS
      </div>

      <h2>Our <span>Products</span></h2>
    </div>

    <%= link_to products_path, class: "news-view-all" do %>
      View all
      <i class="fas fa-arrow-up-right-from-square"></i>
    <% end %>
  </div>

  <div class="news-grid">

    <!-- Product 1 - Bitumen -->
    <article class="news-item">
      <div class="news-image">
        <% if @bitumen_product&.image&.attached? %>
          <%= image_tag @bitumen_product.image,
                        alt: @bitumen_product.name,
                        loading: "lazy" %>
        <% else %>
          <img
            src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=900&q=80"
            alt="Bitumen for road construction and industrial applications"
            loading="lazy"
          >
        <% end %>

        <span class="news-category">BITUMEN</span>
      </div>

      <div class="news-content">
        <div class="news-meta">
          <span>PRODUCT</span>
          <span class="news-dot"></span>
          <span>EXPORT</span>
        </div>

        <h3>Bitumen</h3>

        <p>
          Premium grade bitumen supplier for global construction and infrastructure projects
        </p>

        <%= link_to bitumen_products_path, class: "news-read" do %>
          View product
          <i class="fas fa-arrow-right"></i>
        <% end %>
      </div>
    </article>


    <!-- Product 2 -->
    <article class="news-item">
      <div class="news-image">
        <% if @products[1]&.image&.attached? %>
          <%= image_tag @products[1].image,
                        alt: @products[1].name,
                        loading: "lazy" %>
        <% else %>
          <img
            src="https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?auto=format&fit=crop&w=900&q=80"
            alt="<%= @products[1]&.name.to_s %>"
            loading="lazy"
          >
        <% end %>

        <span class="news-category">
          <%= @products[1]&.name&.upcase || "PRODUCT" %>
        </span>
      </div>

      <div class="news-content">
        <div class="news-meta">
          <span>PRODUCT</span>
          <span class="news-dot"></span>
          <span>EXPORT</span>
        </div>

        <h3><%= @products[1]&.name || "Product" %></h3>

        <p>
          <%= @products[1]&.content.present? ?
                truncate(@products[1].content, length: 100) :
                "Premium product supplier for global projects" %>
        </p>

        <% if @products[1] %>
          <%= link_to product_path(@products[1]), class: "news-read" do %>
            View product
            <i class="fas fa-arrow-right"></i>
          <% end %>
        <% end %>
      </div>
    </article>


