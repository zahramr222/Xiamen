<!-- ABOUT -->
                <section class="about-section">
                    <div class="about-container">
                        <div class="about-content">
                            <div class="about-label">
                                <span class="about-label-line"></span> ABOUT GLOBAL SYNERGY
                            </div>
                            <h2>Trusted <span>Bitumen Supplier</span> Worldwide</h2>
                            <p class="about-description">
                                Premium bitumen, petroleum, and industrial chemical products supplied to clients in 60+ countries with verified quality and on-time delivery.
                            </p>
                            <div class="about-actions">
                                <%= link_to inquiry_path, class: "about-btn about-btn-primary" do %>
                                  <span>Request a Quote</span>
                                <% end %>
                                <%= link_to contact_path, class: "about-btn about-btn-secondary" do %>
                                  <span>Book a Meeting</span>
                                  <i class="fa-regular fa-calendar"></i>
                                <% end %>
                            </div>
                        </div>
                        <div class="about-visual">
                            <div class="about-image">
                                <img src="images/mian-image.webp" alt="Industrial supply and global trade">
                                <div class="about-image-overlay"></div>
                                <div class="about-stat-card">
                                    <div class="about-stat-icon"><i class="fa-solid fa-globe"></i></div>
                                    <div class="about-stat-text">
                                        <strong>60+</strong>
                                        <span>Countries Served</span>
                                    </div>
                                </div>
                                <div class="about-quality-badge">
                                    <i class="fa-solid fa-circle-check"></i>
                                    <span>Verified Quality</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>