<!-- SUPPORT SECTION -->
                <section class="support-section">
                    <div class="support-container">
                        <div class="support-top">
                            <div class="support-heading">
                                <div class="support-label">
                                    <span class="support-label-line"></span> SUPPORT
                                </div>
                                <h2>Why Choose <span>Us</span></h2>
                                <p class="support-intro">
                                    <p class="support-intro">
                                      Global Synergy provides reliable international supply of high-quality bitumen and petroleum products, supported by quality control, flexible logistics and experienced operations.
                                    </p>
                                </p>
                            </div>
                        </div>
                        <div class="support-features">
                            <div class="support-card">
                                <div class="support-card-number">01</div>
                                <div class="support-icon"><i class="fa-solid fa-headset"></i></div>
                                <div class="support-card-content">
                                    <h3>24/7 Support</h3>
                                    <p>Our team is available 24/7 to support you through every shipment for a smooth delivery.</p>
                                </div>
                            </div>
                            <div class="support-card">
                                <div class="support-card-number">02</div>
                                <div class="support-icon"><i class="fa-solid fa-certificate"></i></div>
                                <div class="support-card-content">
                                    <h3>ISO 10004:2018</h3>
                                    <p>Certified to ISO 10004:2018 for consistent quality and customer satisfaction.</p>
                                </div>
                            </div>
                            <div class="support-card">
                                <div class="support-card-number">03</div>
                                <div class="support-icon"><i class="fa-solid fa-clipboard-check"></i></div>
                                <div class="support-card-content">
                                    <h3>SGS: Third-party inspection</h3>
                                    <p>Every shipment is independently verified by SGS for full transparency.</p>
                                </div>
                            </div>
                            <div class="support-card">
                                <div class="support-card-number">04</div>
                                <div class="support-icon"><i class="fa-solid fa-people-group"></i></div>
                                <div class="support-card-content">
                                    <h3>Experienced operations team</h3>
                                    <p>Our experienced team manages every order with precision and care.</p>
                                </div>
                            </div>
                        </div>
                        <div class="support-bottom">
                            <div class="support-bottom-text">
                                <div>
                                    <span class="support-bottom-label">NEED MORE INFORMATION?</span>
                                    <h3>Talk to our <span>sales team</span></h3>
                                </div>
                            </div>
                            <div class="about-actions">
                                <a href="/contact" class="about-btn about-btn-primary">
                                    <span>Contact Us</span>
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                </a>
                                <%= link_to inquiry_path, class: "about-btn about-btn-secondary" do %>
                                  <span>Book a Meeting</span>
                                  <i class="fa-regular fa-calendar"></i>
                                <% end %>
                            </div>
                        </div>
                    </div>
                </section>
