<!-- ARTICLES SECTION -->
<section class="articles-section">
  <div class="articles-header">
    <div class="news-header">
      <div class="news-header-left">
        <div class="partners-label">
          <span class="partners-label-line"></span>
          INSIGHTS
        </div>

        <h2>Latest <span>Articles</span></h2>
      </div>
    </div>

    <%= link_to posts_path, class: "articles-view-all" do %>
      View all
      <i class="fa-solid fa-arrow-right"></i>
    <% end %>
  </div>

  <div class="articles-grid">

    <% if @articles.present? %>

      <% @articles.each do |article| %>

        <article class="article-card">

          <!-- ARTICLE IMAGE -->
          <a href="<%= post_path(article.slug) %>" class="article-image">

            <% if article.image.attached? %>

              <%= image_tag article.image,
                    alt: article.title,
                    loading: "lazy" %>

            <% else %>

              <div class="article-placeholder-image">
                <span>📄</span>
                <span class="placeholder-text">
                  <%= article.title %>
                </span>
              </div>

            <% end %>

            <span class="article-category">
              <%= article.post_type.to_s.upcase %>
            </span>

          </a>


          <!-- ARTICLE CONTENT -->
          <div class="article-content">

            <div class="article-meta">

              <span>
                <i class="fa-regular fa-calendar"></i>
                <%= article.updated_at.strftime("%b %d, %Y") %>
              </span>

              <span class="article-read">
                5 min read
              </span>

            </div>


            <h3>
              <%= link_to article.title, post_path(article.slug) %>
            </h3>


            <p>
              <%= truncate(
                    article.summery.presence || article.content,
                    length: 135
                  ) %>
            </p>


            <%= link_to post_path(article.slug),
                  class: "article-link" do %>

              Read article

              <span>
                <i class="fa-solid fa-arrow-up-right"></i>
              </span>

            <% end %>

          </div>

        </article>

      <% end %>


    <% else %>

      <div class="articles-empty">

        <i class="fa-solid fa-newspaper"></i>

        <h3>No Articles Available</h3>

        <p>
          Check back soon for the latest insights and industry updates.
        </p>

      </div>

    <% end %>

  </div>
</section>