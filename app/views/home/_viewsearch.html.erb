<!-- MOTTO -->
<div class="motto">
  <i class="fa-solid fa-sparkles"></i>
  Search. Discover. Explore.
</div>

<!-- TITLE -->
<h1 class="title">Global Bitumen Supplier</h1>

<!-- SUBTITLE -->
<p class="subtitle">Everything you need, in one place.</p>

<!-- SEARCH -->
<div class="search-wrapper" data-controller="search">
  <form class="search-box" action="/search" method="get" data-turbo="false">
    <div class="search-icon">
      <i class="fa-solid fa-magnifying-glass"></i>
    </div>
    <input
      type="text"
      name="q"
      class="search-input"
      placeholder="What are you looking for?"
      autocomplete="off"
      data-search-target="input"
      data-action="input->search#search"
      value="<%= params[:q] %>"
    >
    <button type="submit" class="search-button">
      <span>Search</span>
      <i class="fa-solid fa-arrow-right d-none"></i>
    </button>
  </form>

  <div class="search-hint">
    Press <span class="keyboard-key">/</span> to focus
  </div>

  <!-- Live dropdown (still works while typing) -->
  <div class="search-results" data-search-target="results" style="display: none;"></div>
</div>